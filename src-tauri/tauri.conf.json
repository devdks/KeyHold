{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeyHold",
  "version": "0.1.1",
  "identifier": "app.keyhold.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run generate",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KeyHold",
        "width": 336,
        "height": 428,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "center": true,
        "alwaysOnTop": true,
        "decorations": false,
        "shadow": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Hold any key for a chosen duration",
    "longDescription": "KeyHold is a compact desktop utility that keeps a selected keyboard key pressed until you stop it or its timer ends."
  }
}
