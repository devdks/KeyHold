{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeyHold",
  "version": "0.1.2",
  "identifier": "app.keyhold.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm generate",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KeyHold",
        "width": 336,
        "height": 428,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "center": true,
        "alwaysOnTop": true,
        "decorations": false,
        "shadow": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Hold any key for a chosen duration",
    "longDescription": "KeyHold is a compact desktop utility that keeps a selected keyboard key pressed until you stop it or its timer ends."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzMzEwRDRENDc2N0JFQTkKUldTcHZtZEhUUTB4ODQ2Mm9Hc3NvOW4vV0tOT0RzNXA2YmpBUy9qbG5FUEFWak9SVi9uV0htSDYK",
      "endpoints": [
        "https://github.com/devdks/KeyHold/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
